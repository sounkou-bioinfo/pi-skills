{
  "name": "pi-skills",
  "version": "1.1.1",
  "private": false,
  "description": "Skills-first Pi package for R, bioinformatics rewrites, DuckDB C extensions, system-R RLM, and a small goals extension.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "bioinformatics",
    "r",
    "duckdb"
  ],
  "files": [
    "extensions",
    "skills",
    "docs",
    "scripts",
    "README.md",
    "README.Rmd",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "render:readme": "Rscript scripts/render_readme.R",
    "check:readme": "Rscript scripts/render_readme.R --check"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": []
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.78.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.1.38",
    "typescript": "^5.8.3"
  }
}
