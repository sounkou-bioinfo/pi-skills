{
  "name": "pi-skills",
  "version": "1.0.0",
  "private": false,
  "description": "Consolidated Pi skills, extensions, prompts, and orchestration helpers for R, bioinformatics rewrites, DuckDB C extensions, subagents, RLM, and goals.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "bioinformatics",
    "r",
    "duckdb",
    "subagent"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "scripts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:rlm:spark": "node ./scripts/validate-rlm-spark.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/subagents",
      "./extensions/rlm",
      "./extensions/goals"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-agent-core": "^0.70.6",
    "@mariozechner/pi-ai": "^0.70.6",
    "@mariozechner/pi-coding-agent": "^0.70.6",
    "@mariozechner/pi-tui": "^0.70.6",
    "@sinclair/typebox": "^0.34.41",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "hyparquet": "^1.25.6",
    "typebox": "^1.1.34",
    "webr": "^0.5.9"
  }
}
